  ],
  "bahouth_verses": [
    {
      "ayah_number": 75,
      "text_raw": "وَلَقَدْ نَادَانَا نُوحٌ فَلَنِعْمَ الْمُجِيبُونَ",
      "verse_key": "37-75"
    },
    {
      "ayah_number": 76,
      "text_raw": "وَنَجَّيْنَاهُ وَأَهْلَهُ مِنْ الْكَرْبِ الْعَظِيمِ",
      "verse_key": "37-76"
    },
    {
      "ayah_number": 77,
      "text_raw": "وَجَعَلْنَا ذُرِّيَّتَهُ هُمْ الْبَاقِينَ",
      "verse_key": "37-77"
    },
    {
      "ayah_number": 78,
      "text_raw": "وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ",
      "verse_key": "37-78"
    },
    {
      "ayah_number": 79,
      "text_raw": "سَلَامٌ عَلَى نُوحٍ فِي الْعَالَمِينَ",
      "verse_key": "37-79"
    },
    {
      "ayah_number": 80,
      "text_raw": "إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنِينَ",
      "verse_key": "37-80"
    },
    {
      "ayah_number": 81,
      "text_raw": "إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ",
      "verse_key": "37-81"
    },
    {
      "ayah_number": 82,
      "text_raw": "ثُمَّ أَغْرَقْنَا الْآخَرِينَ",
      "verse_key": "37-82"
    },
    {
      "ayah_number": 83,
      "text_raw": "وَإِنَّ مِنْ شِيعَتِهِ لَإِبْرَاهِيمَ",
      "verse_key": "37-83"
    },
    {
      "ayah_number": 84,
      "text_raw": "إِذْ جَاءَ رَبَّهُ بِقَلْبٍ سَلِيمٍ",
      "verse_key": "37-84"
    },
    {
      "ayah_number": 85,
      "text_raw": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِ مَاذَا تَعْبُدُونَ",
      "verse_key": "37-85"
    },
    {
      "ayah_number": 86,
      "text_raw": "أَئِفْكًا آلِهَةً دُونَ اللَّهِ تُرِيدُونَ",
      "verse_key": "37-86"
    },
    {
      "ayah_number": 87,
      "text_raw": "فَمَا ظَنُّكُمْ بِرَبِّ الْعَالَمِينَ",
      "verse_key": "37-87"
    },
    {
      "ayah_number": 88,
      "text_raw": "فَنَظَرَ نَظْرَةً فِي النُّجُومِ",
      "verse_key": "37-88"
    },
    {
      "ayah_number": 89,
      "text_raw": "فَقَالَ إِنِّي سَقِيمٌ",
      "verse_key": "37-89"
    },
    {
      "ayah_number": 90,
      "text_raw": "فَتَوَلَّوْا عَنْهُ مُدْبِرِينَ",
      "verse_key": "37-90"
    },
    {
      "ayah_number": 91,
      "text_raw": "فَرَاغَ إِلَى آلِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ",
      "verse_key": "37-91"
    },
    {
      "ayah_number": 92,
      "text_raw": "مَا لَكُمْ لَا تَنْطِقُونَ",
      "verse_key": "37-92"
    },
    {
      "ayah_number": 93,
      "text_raw": "فَرَاغَ عَلَيْهِمْ ضَرْبًا بِالْيَمِينِ",
      "verse_key": "37-93"
    },
    {
      "ayah_number": 94,
      "text_raw": "فَأَقْبَلُوا إِلَيْهِ يَزِفُّونَ",
      "verse_key": "37-94"
    },
    {
      "ayah_number": 95,
      "text_raw": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ",
      "verse_key": "37-95"
    },
    {
      "ayah_number": 96,
      "text_raw": "وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ",
      "verse_key": "37-96"
    },
    {
      "ayah_number": 97,
      "text_raw": "قَالُوا ابْنُوا لَهُ بُنْيَانًا فَأَلْقُوهُ فِي الْجَحِيمِ",
      "verse_key": "37-97"
    },
    {
      "ayah_number": 98,
      "text_raw": "فَأَرَادُوا بِهِ كَيْدًا فَجَعَلْنَاهُمْ الْأَسْفَلِينَ",
      "verse_key": "37-98"
    },
    {
      "ayah_number": 99,
      "text_raw": "وَقَالَ إِنِّي ذَاهِبٌ إِلَى رَبِّي سَيَهْدِينِ",
      "verse_key": "37-99"
    },
    {
      "ayah_number": 100,
      "text_raw": "رَبِّ هَبْ لِي مِنْ الصَّالِحِينَ",
      "verse_key": "37-100"
    },
    {
      "ayah_number": 101,
      "text_raw": "فَبَشَّرْنَاهُ بِغُلَامٍ حَلِيمٍ",
      "verse_key": "37-101"
    },
    {
      "ayah_number": 102,
      "text_raw": "فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ قَالَ يَابُنَيَّ إِنِّي أَرَى فِي الْمَنَامِ أَنِّي أَذْبَحُكَ فَانْظُرْ مَاذَا تَرَى قَالَ يَاأَبَتِ افْعَلْ مَا تُؤْمَرُ سَتَجِدُنِي إِنْ شَاءَ اللَّهُ مِنْ الصَّابِرِينَ",
      "verse_key": "37-102"
    },
    {
      "ayah_number": 103,
      "text_raw": "فَلَمَّا أَسْلَمَا وَتَلَّهُ لِلْجَبِينِ",
      "verse_key": "37-103"
    },
    {
      "ayah_number": 104,
      "text_raw": "وَنَادَيْنَاهُ أَنْ يَاإِبْرَاهِيمُ",
      "verse_key": "37-104"
    },
    {
      "ayah_number": 105,
      "text_raw": "قَدْ صَدَّقْتَ الرُّؤْيَا إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنِينَ",
      "verse_key": "37-105"
    },
    {
      "ayah_number": 106,
      "text_raw": "إِنَّ هَذَا لَهُوَ الْبَلَاءُ الْمُبِينُ",
      "verse_key": "37-106"
    },
    {
      "ayah_number": 107,
      "text_raw": "وَفَدَيْنَاهُ بِذِبْحٍ عَظِيمٍ",
      "verse_key": "37-107"
    },
    {
      "ayah_number": 108,
      "text_raw": "وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ",
      "verse_key": "37-108"
    },
    {
      "ayah_number": 109,
      "text_raw": "سَلَامٌ عَلَى إِبْرَاهِيمَ",
      "verse_key": "37-109"
    },
    {
      "ayah_number": 110,
      "text_raw": "كَذَلِكَ نَجْزِي الْمُحْسِنِينَ",
      "verse_key": "37-110"
    },
    {
      "ayah_number": 111,
      "text_raw": "إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ",
      "verse_key": "37-111"
    },
    {
      "ayah_number": 112,
      "text_raw": "وَبَشَّرْنَاهُ بِإِسْحَاقَ نَبِيًّا مِنْ الصَّالِحِينَ",
      "verse_key": "37-112"
    },
    {
      "ayah_number": 113,
      "text_raw": "وَبَارَكْنَا عَلَيْهِ وَعَلَى إِسْحَاقَ وَمِنْ ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِنَفْسِهِ مُبِينٌ",
      "verse_key": "37-113"
    }
  ],
