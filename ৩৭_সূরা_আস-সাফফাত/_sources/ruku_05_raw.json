{
  "schema_version": "2.0-raw-mcp",
  "surah_id": 37,
  "ruku_number": 5,
  "ayah_range": [
    139,
    182
  ],
  "bahouth_verses": [
    {
      "ayah_number": 139,
      "text_raw": "وَإِنَّ يُونُسَ لَمِنْ الْمُرْسَلِينَ",
      "verse_key": "37-139"
    },
    {
      "ayah_number": 140,
      "text_raw": "إِذْ أَبَقَ إِلَى الْفُلْكِ الْمَشْحُونِ",
      "verse_key": "37-140"
    },
    {
      "ayah_number": 141,
      "text_raw": "فَسَاهَمَ فَكَانَ مِنْ الْمُدْحَضِينَ",
      "verse_key": "37-141"
    },
    {
      "ayah_number": 142,
      "text_raw": "فَالْتَقَمَهُ الْحُوتُ وَهُوَ مُلِيمٌ",
      "verse_key": "37-142"
    },
    {
      "ayah_number": 143,
      "text_raw": "فَلَوْلَا أَنَّهُ كَانَ مِنْ الْمُسَبِّحِينَ",
      "verse_key": "37-143"
    },
    {
      "ayah_number": 144,
      "text_raw": "لَلَبِثَ فِي بَطْنِهِ إِلَى يَوْمِ يُبْعَثُونَ",
      "verse_key": "37-144"
    },
    {
      "ayah_number": 145,
      "text_raw": "فَنَبَذْنَاهُ بِالْعَرَاءِ وَهُوَ سَقِيمٌ",
      "verse_key": "37-145"
    },
    {
      "ayah_number": 146,
      "text_raw": "وَأَنْبَتْنَا عَلَيْهِ شَجَرَةً مِنْ يَقْطِينٍ",
      "verse_key": "37-146"
    },
    {
      "ayah_number": 147,
      "text_raw": "وَأَرْسَلْنَاهُ إِلَى مِائَةِ أَلْفٍ أَوْ يَزِيدُونَ",
      "verse_key": "37-147"
    },
    {
      "ayah_number": 148,
      "text_raw": "فَآمَنُوا فَمَتَّعْنَاهُمْ إِلَى حِينٍ",
      "verse_key": "37-148"
    },
    {
      "ayah_number": 149,
      "text_raw": "فَاسْتَفْتِهِمْ أَلِرَبِّكَ الْبَنَاتُ وَلَهُمْ الْبَنُونَ",
      "verse_key": "37-149"
    },
    {
      "ayah_number": 150,
      "text_raw": "أَمْ خَلَقْنَا الْمَلَائِكَةَ إِنَاثًا وَهُمْ شَاهِدُونَ",
      "verse_key": "37-150"
    },
    {
      "ayah_number": 151,
      "text_raw": "أَلَا إِنَّهُمْ مِنْ إِفْكِهِمْ لَيَقُولُونَ",
      "verse_key": "37-151"
    },
    {
      "ayah_number": 152,
      "text_raw": "وَلَدَ اللَّهُ وَإِنَّهُمْ لَكَاذِبُونَ",
      "verse_key": "37-152"
    },
    {
      "ayah_number": 153,
      "text_raw": "أَصْطَفَى الْبَنَاتِ عَلَى الْبَنِينَ",
      "verse_key": "37-153"
    },
    {
      "ayah_number": 154,
      "text_raw": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ",
      "verse_key": "37-154"
    },
    {
      "ayah_number": 155,
      "text_raw": "أَفَلَا تَذَكَّرُونَ",
      "verse_key": "37-155"
    },
    {
      "ayah_number": 156,
      "text_raw": "أَمْ لَكُمْ سُلْطَانٌ مُبِينٌ",
      "verse_key": "37-156"
    },
    {
      "ayah_number": 157,
      "text_raw": "فَأْتُوا بِكِتَابِكُمْ إِنْ كُنْتُمْ صَادِقِينَ",
      "verse_key": "37-157"
    },
    {
      "ayah_number": 158,
      "text_raw": "وَجَعَلُوا بَيْنَهُ وَبَيْنَ الْجِنَّةِ نَسَبًا وَلَقَدْ عَلِمَتْ الْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ",
      "verse_key": "37-158"
    },
    {
      "ayah_number": 159,
      "text_raw": "سُبْحَانَ اللَّهِ عَمَّا يَصِفُونَ",
      "verse_key": "37-159"
    },
    {
      "ayah_number": 160,
      "text_raw": "إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ",
      "verse_key": "37-160"
    },
    {
      "ayah_number": 161,
      "text_raw": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ",
      "verse_key": "37-161"
    },
    {
      "ayah_number": 162,
      "text_raw": "مَا أَنْتُمْ عَلَيْهِ بِفَاتِنِينَ",
      "verse_key": "37-162"
    },
    {
      "ayah_number": 163,
      "text_raw": "إِلَّا مَنْ هُوَ صَالِ الْجَحِيمِ",
      "verse_key": "37-163"
    },
    {
      "ayah_number": 164,
      "text_raw": "وَمَا مِنَّا إِلَّا لَهُ مَقَامٌ مَعْلُومٌ",
      "verse_key": "37-164"
    },
    {
      "ayah_number": 165,
      "text_raw": "وَإِنَّا لَنَحْنُ الصَّافُّونَ",
      "verse_key": "37-165"
    },
    {
      "ayah_number": 166,
      "text_raw": "وَإِنَّا لَنَحْنُ الْمُسَبِّحُونَ",
      "verse_key": "37-166"
    },
    {
      "ayah_number": 167,
      "text_raw": "وَإِنْ كَانُوا لَيَقُولُونَ",
      "verse_key": "37-167"
    },
    {
      "ayah_number": 168,
      "text_raw": "لَوْ أَنَّ عِنْدَنَا ذِكْرًا مِنْ الْأَوَّلِينَ",
      "verse_key": "37-168"
    },
    {
      "ayah_number": 169,
      "text_raw": "لَكُنَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ",
      "verse_key": "37-169"
    },
    {
      "ayah_number": 170,
      "text_raw": "فَكَفَرُوا بِهِ فَسَوْفَ يَعْلَمُونَ",
      "verse_key": "37-170"
    },
    {
      "ayah_number": 171,
      "text_raw": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَلِينَ",
      "verse_key": "37-171"
    },
    {
      "ayah_number": 172,
      "text_raw": "إِنَّهُمْ لَهُمْ الْمَنْصُورُونَ",
      "verse_key": "37-172"
    },
    {
      "ayah_number": 173,
      "text_raw": "وَإِنَّ جُنْدَنَا لَهُمْ الْغَالِبُونَ",
      "verse_key": "37-173"
    },
    {
      "ayah_number": 174,
      "text_raw": "فَتَوَلَّ عَنْهُمْ حَتَّى حِينٍ",
      "verse_key": "37-174"
    },
    {
      "ayah_number": 175,
      "text_raw": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ",
      "verse_key": "37-175"
    },
    {
      "ayah_number": 176,
      "text_raw": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ",
      "verse_key": "37-176"
    },
    {
      "ayah_number": 177,
      "text_raw": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَاءَ صَبَاحُ الْمُنْذَرِينَ",
      "verse_key": "37-177"
    },
    {
      "ayah_number": 178,
      "text_raw": "وَتَوَلَّ عَنْهُمْ حَتَّى حِينٍ",
      "verse_key": "37-178"
    },
    {
      "ayah_number": 179,
      "text_raw": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ",
      "verse_key": "37-179"
    },
    {
      "ayah_number": 180,
      "text_raw": "سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ",
      "verse_key": "37-180"
    },
    {
      "ayah_number": 181,
      "text_raw": "وَسَلَامٌ عَلَى الْمُرْسَلِينَ",
      "verse_key": "37-181"
    },
    {
      "ayah_number": 182,
      "text_raw": "وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
      "verse_key": "37-182"
    }
  ],
