  ],
  "bahouth_verses": [
    {
      "ayah_number": 37,
      "text_raw": "بَلْ جَاءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلِينَ",
      "verse_key": "37-37"
    },
    {
      "ayah_number": 38,
      "text_raw": "إِنَّكُمْ لَذَائِقُو الْعَذَابِ الْأَلِيمِ",
      "verse_key": "37-38"
    },
    {
      "ayah_number": 39,
      "text_raw": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنْتُمْ تَعْمَلُونَ",
      "verse_key": "37-39"
    },
    {
      "ayah_number": 40,
      "text_raw": "إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ",
      "verse_key": "37-40"
    },
    {
      "ayah_number": 41,
      "text_raw": "أُولَئِكَ لَهُمْ رِزْقٌ مَعْلُومٌ",
      "verse_key": "37-41"
    },
    {
      "ayah_number": 42,
      "text_raw": "فَوَاكِهُ وَهُمْ مُكْرَمُونَ",
      "verse_key": "37-42"
    },
    {
      "ayah_number": 43,
      "text_raw": "فِي جَنَّاتِ النَّعِيمِ",
      "verse_key": "37-43"
    },
    {
      "ayah_number": 44,
      "text_raw": "عَلَى سُرُرٍ مُتَقَابِلِينَ",
      "verse_key": "37-44"
    },
    {
      "ayah_number": 45,
      "text_raw": "يُطَافُ عَلَيْهِمْ بِكَأْسٍ مِنْ مَعِينٍ",
      "verse_key": "37-45"
    },
    {
      "ayah_number": 46,
      "text_raw": "بَيْضَاءَ لَذَّةٍ لِلشَّارِبِينَ",
      "verse_key": "37-46"
    },
    {
      "ayah_number": 47,
      "text_raw": "لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنْزَفُونَ",
      "verse_key": "37-47"
    },
    {
      "ayah_number": 48,
      "text_raw": "وَعِنْدَهُمْ قَاصِرَاتُ الطَّرْفِ عِينٌ",
      "verse_key": "37-48"
    },
    {
      "ayah_number": 49,
      "text_raw": "كَأَنَّهُنَّ بَيْضٌ مَكْنُونٌ",
      "verse_key": "37-49"
    },
    {
      "ayah_number": 50,
      "text_raw": "فَأَقْبَلَ بَعْضُهُمْ عَلَى بَعْضٍ يَتَسَاءَلُونَ",
      "verse_key": "37-50"
    },
    {
      "ayah_number": 51,
      "text_raw": "قَالَ قَائِلٌ مِنْهُمْ إِنِّي كَانَ لِي قَرِينٌ",
      "verse_key": "37-51"
    },
    {
      "ayah_number": 52,
      "text_raw": "يَقُولُ أَإِنَّكَ لَمِنْ الْمُصَدِّقِينَ",
      "verse_key": "37-52"
    },
    {
      "ayah_number": 53,
      "text_raw": "أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَدِينُونَ",
      "verse_key": "37-53"
    },
    {
      "ayah_number": 54,
      "text_raw": "قَالَ هَلْ أَنْتُمْ مُطَّلِعُونَ",
      "verse_key": "37-54"
    },
    {
      "ayah_number": 55,
      "text_raw": "فَاطَّلَعَ فَرَآهُ فِي سَوَاءِ الْجَحِيمِ",
      "verse_key": "37-55"
    },
    {
      "ayah_number": 56,
      "text_raw": "قَالَ تَاللَّهِ إِنْ كِدْتَ لَتُرْدِينِ",
      "verse_key": "37-56"
    },
    {
      "ayah_number": 57,
      "text_raw": "وَلَوْلَا نِعْمَةُ رَبِّي لَكُنْتُ مِنْ الْمُحْضَرِينَ",
      "verse_key": "37-57"
    },
    {
      "ayah_number": 58,
      "text_raw": "أَفَمَا نَحْنُ بِمَيِّتِينَ",
      "verse_key": "37-58"
    },
    {
      "ayah_number": 59,
      "text_raw": "إِلَّا مَوْتَتَنَا الْأُولَى وَمَا نَحْنُ بِمُعَذَّبِينَ",
      "verse_key": "37-59"
    },
    {
      "ayah_number": 60,
      "text_raw": "إِنَّ هَذَا لَهُوَ الْفَوْزُ الْعَظِيمُ",
      "verse_key": "37-60"
    },
    {
      "ayah_number": 61,
      "text_raw": "لِمِثْلِ هَذَا فَلْيَعْمَلْ الْعَامِلُونَ",
      "verse_key": "37-61"
    },
    {
      "ayah_number": 62,
      "text_raw": "أَذَلِكَ خَيْرٌ نُزُلًا أَمْ شَجَرَةُ الزَّقُّومِ",
      "verse_key": "37-62"
    },
    {
      "ayah_number": 63,
      "text_raw": "إِنَّا جَعَلْنَاهَا فِتْنَةً لِلظَّالِمِينَ",
      "verse_key": "37-63"
    },
    {
      "ayah_number": 64,
      "text_raw": "إِنَّهَا شَجَرَةٌ تَخْرُجُ فِي أَصْلِ الْجَحِيمِ",
      "verse_key": "37-64"
    },
    {
      "ayah_number": 65,
      "text_raw": "طَلْعُهَا كَأَنَّهُ رُءُوسُ الشَّيَاطِينِ",
      "verse_key": "37-65"
    },
    {
      "ayah_number": 66,
      "text_raw": "فَإِنَّهُمْ لَآكِلُونَ مِنْهَا فَمَالِئُونَ مِنْهَا الْبُطُونَ",
      "verse_key": "37-66"
    },
    {
      "ayah_number": 67,
      "text_raw": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِنْ حَمِيمٍ",
      "verse_key": "37-67"
    },
    {
      "ayah_number": 68,
      "text_raw": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى الْجَحِيمِ",
      "verse_key": "37-68"
    },
    {
      "ayah_number": 69,
      "text_raw": "إِنَّهُمْ أَلْفَوْا آبَاءَهُمْ ضَالِّينَ",
      "verse_key": "37-69"
    },
    {
      "ayah_number": 70,
      "text_raw": "فَهُمْ عَلَى آثَارِهِمْ يُهْرَعُونَ",
      "verse_key": "37-70"
    },
    {
      "ayah_number": 71,
      "text_raw": "وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ الْأَوَّلِينَ",
      "verse_key": "37-71"
    },
    {
      "ayah_number": 72,
      "text_raw": "وَلَقَدْ أَرْسَلْنَا فِيهِمْ مُنْذِرِينَ",
      "verse_key": "37-72"
    },
    {
      "ayah_number": 73,
      "text_raw": "فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنْذَرِينَ",
      "verse_key": "37-73"
    },
    {
      "ayah_number": 74,
      "text_raw": "إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ",
      "verse_key": "37-74"
    }
  ],
