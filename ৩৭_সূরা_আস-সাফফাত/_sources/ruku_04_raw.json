  "bahouth_verses": [
    {
      "ayah_number": 114,
      "text_raw": "وَلَقَدْ مَنَنَّا عَلَى مُوسَى وَهَارُونَ",
      "verse_key": "37-114"
    },
    {
      "ayah_number": 115,
      "text_raw": "وَنَجَّيْنَاهُمَا وَقَوْمَهُمَا مِنْ الْكَرْبِ الْعَظِيمِ",
      "verse_key": "37-115"
    },
    {
      "ayah_number": 116,
      "text_raw": "وَنَصَرْنَاهُمْ فَكَانُوا هُمْ الْغَالِبِينَ",
      "verse_key": "37-116"
    },
    {
      "ayah_number": 117,
      "text_raw": "وَآتَيْنَاهُمَا الْكِتَابَ الْمُسْتَبِينَ",
      "verse_key": "37-117"
    },
    {
      "ayah_number": 118,
      "text_raw": "وَهَدَيْنَاهُمَا الصِّرَاطَ الْمُسْتَقِيمَ",
      "verse_key": "37-118"
    },
    {
      "ayah_number": 119,
      "text_raw": "وَتَرَكْنَا عَلَيْهِمَا فِي الْآخِرِينَ",
      "verse_key": "37-119"
    },
    {
      "ayah_number": 120,
      "text_raw": "سَلَامٌ عَلَى مُوسَى وَهَارُونَ",
      "verse_key": "37-120"
    },
    {
      "ayah_number": 121,
      "text_raw": "إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنِينَ",
      "verse_key": "37-121"
    },
    {
      "ayah_number": 122,
      "text_raw": "إِنَّهُمَا مِنْ عِبَادِنَا الْمُؤْمِنِينَ",
      "verse_key": "37-122"
    },
    {
      "ayah_number": 123,
      "text_raw": "وَإِنَّ إِلْيَاسَ لَمِنْ الْمُرْسَلِينَ",
      "verse_key": "37-123"
    },
    {
      "ayah_number": 124,
      "text_raw": "إِذْ قَالَ لِقَوْمِهِ أَلَا تَتَّقُونَ",
      "verse_key": "37-124"
    },
    {
      "ayah_number": 125,
      "text_raw": "أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ الْخَالِقِينَ",
      "verse_key": "37-125"
    },
    {
      "ayah_number": 126,
      "text_raw": "اللَّهَ رَبَّكُمْ وَرَبَّ آبَائِكُمْ الْأَوَّلِينَ",
      "verse_key": "37-126"
    },
    {
      "ayah_number": 127,
      "text_raw": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ",
      "verse_key": "37-127"
    },
    {
      "ayah_number": 128,
      "text_raw": "إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ",
      "verse_key": "37-128"
    },
    {
      "ayah_number": 129,
      "text_raw": "وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ",
      "verse_key": "37-129"
    },
    {
      "ayah_number": 130,
      "text_raw": "سَلَامٌ عَلَى إِلْ يَاسِينَ",
      "verse_key": "37-130"
    },
    {
      "ayah_number": 131,
      "text_raw": "إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنِينَ",
      "verse_key": "37-131"
    },
    {
      "ayah_number": 132,
      "text_raw": "إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ",
      "verse_key": "37-132"
    },
    {
      "ayah_number": 133,
      "text_raw": "وَإِنَّ لُوطًا لَمِنْ الْمُرْسَلِينَ",
      "verse_key": "37-133"
    },
    {
      "ayah_number": 134,
      "text_raw": "إِذْ نَجَّيْنَاهُ وَأَهْلَهُ أَجْمَعِينَ",
      "verse_key": "37-134"
    },
    {
      "ayah_number": 135,
      "text_raw": "إِلَّا عَجُوزًا فِي الْغَابِرِينَ",
      "verse_key": "37-135"
    },
    {
      "ayah_number": 136,
      "text_raw": "ثُمَّ دَمَّرْنَا الْآخَرِينَ",
      "verse_key": "37-136"
    },
    {
      "ayah_number": 137,
      "text_raw": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِمْ مُصْبِحِينَ",
      "verse_key": "37-137"
    },
    {
      "ayah_number": 138,
      "text_raw": "وَبِاللَّيْلِ أَفَلَا تَعْقِلُونَ",
      "verse_key": "37-138"
    }
  ],
