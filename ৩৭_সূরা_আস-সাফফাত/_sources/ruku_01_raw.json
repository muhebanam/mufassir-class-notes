  ],
  "bahouth_verses": [
    {
      "ayah_number": 1,
      "text_raw": "وَالصَّافَّاتِ صَفًّا",
      "verse_key": "37-1"
    },
    {
      "ayah_number": 2,
      "text_raw": "فَالزَّاجِرَاتِ زَجْرًا",
      "verse_key": "37-2"
    },
    {
      "ayah_number": 3,
      "text_raw": "فَالتَّالِيَاتِ ذِكْرًا",
      "verse_key": "37-3"
    },
    {
      "ayah_number": 4,
      "text_raw": "إِنَّ إِلَهَكُمْ لَوَاحِدٌ",
      "verse_key": "37-4"
    },
    {
      "ayah_number": 5,
      "text_raw": "رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ",
      "verse_key": "37-5"
    },
    {
      "ayah_number": 6,
      "text_raw": "إِنَّا زَيَّنَّا السَّمَاءَ الدُّنْيَا بِزِينَةٍ الْكَوَاكِبِ",
      "verse_key": "37-6"
    },
    {
      "ayah_number": 7,
      "text_raw": "وَحِفْظًا مِنْ كُلِّ شَيْطَانٍ مَارِدٍ",
      "verse_key": "37-7"
    },
    {
      "ayah_number": 8,
      "text_raw": "لَا يَسَّمَّعُونَ إِلَى الْمَلَإِ الْأَعْلَى وَيُقْذَفُونَ مِنْ كُلِّ جَانِبٍ",
      "verse_key": "37-8"
    },
    {
      "ayah_number": 9,
      "text_raw": "دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌ",
      "verse_key": "37-9"
    },
    {
      "ayah_number": 10,
      "text_raw": "إِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَأَتْبَعَهُ شِهَابٌ ثَاقِبٌ",
      "verse_key": "37-10"
    },
    {
      "ayah_number": 11,
      "text_raw": "فَاسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَمْ مَنْ خَلَقْنَا إِنَّا خَلَقْنَاهُمْ مِنْ طِينٍ لَازِبٍ",
      "verse_key": "37-11"
    },
    {
      "ayah_number": 12,
      "text_raw": "بَلْ عَجِبْتَ وَيَسْخَرُونَ",
      "verse_key": "37-12"
    },
    {
      "ayah_number": 13,
      "text_raw": "وَإِذَا ذُكِّرُوا لَا يَذْكُرُونَ",
      "verse_key": "37-13"
    },
    {
      "ayah_number": 14,
      "text_raw": "وَإِذَا رَأَوْا آيَةً يَسْتَسْخِرُونَ",
      "verse_key": "37-14"
    },
    {
      "ayah_number": 15,
      "text_raw": "وَقَالُوا إِنْ هَذَا إِلَّا سِحْرٌ مُبِينٌ",
      "verse_key": "37-15"
    },
    {
      "ayah_number": 16,
      "text_raw": "أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ",
      "verse_key": "37-16"
    },
    {
      "ayah_number": 17,
      "text_raw": "أَوَآبَاؤُنَا الْأَوَّلُونَ",
      "verse_key": "37-17"
    },
    {
      "ayah_number": 18,
      "text_raw": "قُلْ نَعَمْ وَأَنْتُمْ دَاخِرُونَ",
      "verse_key": "37-18"
    },
    {
      "ayah_number": 19,
      "text_raw": "فَإِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ فَإِذَا هُمْ يَنْظُرُونَ",
      "verse_key": "37-19"
    },
    {
      "ayah_number": 20,
      "text_raw": "وَقَالُوا يَاوَيْلَنَا هَذَا يَوْمُ الدِّينِ",
      "verse_key": "37-20"
    },
    {
      "ayah_number": 21,
      "text_raw": "هَذَا يَوْمُ الْفَصْلِ الَّذِي كُنْتُمْ بِهِ تُكَذِّبُونَ",
      "verse_key": "37-21"
    },
    {
      "ayah_number": 22,
      "text_raw": "احْشُرُوا الَّذِينَ ظَلَمُوا وَأَزْوَاجَهُمْ وَمَا كَانُوا يَعْبُدُونَ",
      "verse_key": "37-22"
    },
    {
      "ayah_number": 23,
      "text_raw": "مِنْ دُونِ اللَّهِ فَاهْدُوهُمْ إِلَى صِرَاطِ الْجَحِيمِ",
      "verse_key": "37-23"
    },
    {
      "ayah_number": 24,
      "text_raw": "وَقِفُوهُمْ إِنَّهُمْ مَسْئُولُونَ",
      "verse_key": "37-24"
    },
    {
      "ayah_number": 25,
      "text_raw": "مَا لَكُمْ لَا تَنَاصَرُونَ",
      "verse_key": "37-25"
    },
    {
      "ayah_number": 26,
      "text_raw": "بَلْ هُمْ الْيَوْمَ مُسْتَسْلِمُونَ",
      "verse_key": "37-26"
    },
    {
      "ayah_number": 27,
      "text_raw": "وَأَقْبَلَ بَعْضُهُمْ عَلَى بَعْضٍ يَتَسَاءَلُونَ",
      "verse_key": "37-27"
    },
    {
      "ayah_number": 28,
      "text_raw": "قَالُوا إِنَّكُمْ كُنْتُمْ تَأْتُونَنَا عَنْ الْيَمِينِ",
      "verse_key": "37-28"
    },
    {
      "ayah_number": 29,
      "text_raw": "قَالُوا بَلْ لَمْ تَكُونُوا مُؤْمِنِينَ",
      "verse_key": "37-29"
    },
    {
      "ayah_number": 30,
      "text_raw": "وَمَا كَانَ لَنَا عَلَيْكُمْ مِنْ سُلْطَانٍ بَلْ كُنْتُمْ قَوْمًا طَاغِينَ",
      "verse_key": "37-30"
    },
    {
      "ayah_number": 31,
      "text_raw": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَا إِنَّا لَذَائِقُونَ",
      "verse_key": "37-31"
    },
    {
      "ayah_number": 32,
      "text_raw": "فَأَغْوَيْنَاكُمْ إِنَّا كُنَّا غَاوِينَ",
      "verse_key": "37-32"
    },
    {
      "ayah_number": 33,
      "text_raw": "فَإِنَّهُمْ يَوْمَئِذٍ فِي الْعَذَابِ مُشْتَرِكُونَ",
      "verse_key": "37-33"
    },
    {
      "ayah_number": 34,
      "text_raw": "إِنَّا كَذَلِكَ نَفْعَلُ بِالْمُجْرِمِينَ",
      "verse_key": "37-34"
    },
    {
      "ayah_number": 35,
      "text_raw": "إِنَّهُمْ كَانُوا إِذَا قِيلَ لَهُمْ لَا إِلَهَ إِلَّا اللَّهُ يَسْتَكْبِرُونَ",
      "verse_key": "37-35"
    },
    {
      "ayah_number": 36,
      "text_raw": "وَيَقُولُونَ أَئِنَّا لَتَارِكُو آلِهَتِنَا لِشَاعِرٍ مَجْنُونٍ",
      "verse_key": "37-36"
    }
  ],
