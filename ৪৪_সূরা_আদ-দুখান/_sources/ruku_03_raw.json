  "bahouth_verses": [
    {
      "ayah_number": 43,
      "text_raw": "إِنَّ شَجَرَةَ الزَّقُّومِ",
      "verse_key": "44-43"
    },
    {
      "ayah_number": 44,
      "text_raw": "طَعَامُ الْأَثِيمِ",
      "verse_key": "44-44"
    },
    {
      "ayah_number": 45,
      "text_raw": "كَالْمُهْلِ يَغْلِي فِي الْبُطُونِ",
      "verse_key": "44-45"
    },
    {
      "ayah_number": 46,
      "text_raw": "كَغَلْيِ الْحَمِيمِ",
      "verse_key": "44-46"
    },
    {
      "ayah_number": 47,
      "text_raw": "خُذُوهُ فَاعْتِلُوهُ إِلَى سَوَاءِ الْجَحِيمِ",
      "verse_key": "44-47"
    },
    {
      "ayah_number": 48,
      "text_raw": "ثُمَّ صُبُّوا فَوْقَ رَأْسِهِ مِنْ عَذَابِ الْحَمِيمِ",
      "verse_key": "44-48"
    },
    {
      "ayah_number": 49,
      "text_raw": "ذُقْ إِنَّكَ أَنْتَ الْعَزِيزُ الْكَرِيمُ",
      "verse_key": "44-49"
    },
    {
      "ayah_number": 50,
      "text_raw": "إِنَّ هَذَا مَا كُنْتُمْ بِهِ تَمْتَرُونَ",
      "verse_key": "44-50"
    },
    {
      "ayah_number": 51,
      "text_raw": "إِنَّ الْمُتَّقِينَ فِي مَقَامٍ أَمِينٍ",
      "verse_key": "44-51"
    },
    {
      "ayah_number": 52,
      "text_raw": "فِي جَنَّاتٍ وَعُيُونٍ",
      "verse_key": "44-52"
    },
    {
      "ayah_number": 53,
      "text_raw": "يَلْبَسُونَ مِنْ سُنْدُسٍ وَإِسْتَبْرَقٍ مُتَقَابِلِينَ",
      "verse_key": "44-53"
    },
    {
      "ayah_number": 54,
      "text_raw": "كَذَلِكَ وَزَوَّجْنَاهُمْ بِحُورٍ عِينٍ",
      "verse_key": "44-54"
    },
    {
      "ayah_number": 55,
      "text_raw": "يَدْعُونَ فِيهَا بِكُلِّ فَاكِهَةٍ آمِنِينَ",
      "verse_key": "44-55"
    },
    {
      "ayah_number": 56,
      "text_raw": "لَا يَذُوقُونَ فِيهَا الْمَوْتَ إِلَّا الْمَوْتَةَ الْأُولَى وَوَقَاهُمْ عَذَابَ الْجَحِيمِ",
      "verse_key": "44-56"
    },
    {
      "ayah_number": 57,
      "text_raw": "فَضْلًا مِنْ رَبِّكَ ذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ",
      "verse_key": "44-57"
    },
    {
      "ayah_number": 58,
      "text_raw": "فَإِنَّمَا يَسَّرْنَاهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ",
      "verse_key": "44-58"
    },
    {
      "ayah_number": 59,
      "text_raw": "فَارْتَقِبْ إِنَّهُمْ مُرْتَقِبُونَ",
      "verse_key": "44-59"
    }
  ],
