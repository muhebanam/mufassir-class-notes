      "letter_count": 19
    },
    {
      "verse_id": 3002,
      "surah_id": 26,
      "ayah_number": 70,
      "verse_key": "26-70",
      "page_number": 370,
      "text_raw": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِ مَا تَعْبُدُونَ",
