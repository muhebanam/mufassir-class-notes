      "letter_count": 23
    },
    {
      "verse_id": 3003,
      "surah_id": 26,
      "ayah_number": 71,
      "verse_key": "26-71",
      "page_number": 370,
      "text_raw": "قَالُوا نَعْبُدُ أَصْنَامًا فَنَظَلُّ لَهَا عَاكِفِينَ",
      "word_count": 6,
      "letter_count": 28
    },
    {
      "verse_id": 3004,
      "surah_id": 26,
      "ayah_number": 72,
      "verse_key": "26-72",
      "page_number": 370,
      "text_raw": "قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ",
      "word_count": 5,
      "letter_count": 20
    },
    {
      "verse_id": 3005,
      "surah_id": 26,
      "ayah_number": 73,
      "verse_key": "26-73",
      "page_number": 370,
      "text_raw": "أَوْ يَنْفَعُونَكُمْ أَوْ يَضُرُّونَ",
      "word_count": 4,
      "letter_count": 17
    },
    {
      "verse_id": 3006,
      "surah_id": 26,
      "ayah_number": 74,
      "verse_key": "26-74",
      "page_number": 370,
      "text_raw": "قَالُوا بَلْ وَجَدْنَا آبَاءَنَا كَذَلِكَ يَفْعَلُونَ",
      "word_count": 6,
      "letter_count": 28
    },
    {
      "verse_id": 3007,
      "surah_id": 26,
      "ayah_number": 75,
      "verse_key": "26-75",
      "page_number": 370,
      "text_raw": "قَالَ أَفَرَأَيْتُمْ مَا كُنْتُمْ تَعْبُدُونَ",
      "word_count": 5,
      "letter_count": 22
    },
    {
      "verse_id": 3008,
      "surah_id": 26,
      "ayah_number": 76,
      "verse_key": "26-76",
      "page_number": 370,
      "text_raw": "أَنْتُمْ وَآبَاؤُكُمْ الْأَقْدَمُونَ",
      "word_count": 3,
      "letter_count": 19
    },
    {
      "verse_id": 3009,
      "surah_id": 26,
      "ayah_number": 77,
      "verse_key": "26-77",
      "page_number": 370,
      "text_raw": "فَإِنَّهُمْ عَدُوٌّ لِي إِلَّا رَبَّ الْعَالَمِينَ",
      "word_count": 6,
      "letter_count": 23
    },
    {
      "verse_id": 3010,
      "surah_id": 26,
      "ayah_number": 78,
      "verse_key": "26-78",
      "page_number": 370,
      "text_raw": "الَّذِي خَلَقَنِي فَهُوَ يَهْدِينِ",
      "word_count": 4,
      "letter_count": 17
    },
    {
      "verse_id": 3011,
      "surah_id": 26,
      "ayah_number": 79,
      "verse_key": "26-79",
      "page_number": 370,
      "text_raw": "وَالَّذِي هُوَ يُطْعِمُنِي وَيَسْقِينِ",
      "word_count": 4,
      "letter_count": 19
    },
    {
      "verse_id": 3012,
      "surah_id": 26,
      "ayah_number": 80,
      "verse_key": "26-80",
      "page_number": 370,
      "text_raw": "وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ",
      "word_count": 4,
      "letter_count": 16
    },
    {
      "verse_id": 3013,
      "surah_id": 26,
      "ayah_number": 81,
      "verse_key": "26-81",
      "page_number": 370,
      "text_raw": "وَالَّذِي يُمِيتُنِي ثُمَّ يُحْيِينِ",
      "word_count": 4,
      "letter_count": 18
    },
    {
      "verse_id": 3014,
      "surah_id": 26,
      "ayah_number": 82,
      "verse_key": "26-82",
      "page_number": 370,
      "text_raw": "وَالَّذِي أَطْمَعُ أَنْ يَغْفِرَ لِي خَطِيئَتِي يَوْمَ الدِّينِ",
      "word_count": 8,
      "letter_count": 31
    },
    {
      "verse_id": 3015,
      "surah_id": 26,
      "ayah_number": 83,
      "verse_key": "26-83",
      "page_number": 370,
      "text_raw": "رَبِّ هَبْ لِي حُكْمًا وَأَلْحِقْنِي بِالصَّالِحِينَ",
      "word_count": 6,
      "letter_count": 26
    },
    {
      "verse_id": 3016,
      "surah_id": 26,
      "ayah_number": 84,
      "verse_key": "26-84",
      "page_number": 371,
      "text_raw": "وَاجْعَلْ لِي لِسَانَ صِدْقٍ فِي الْآخِرِينَ",
      "word_count": 6,
      "letter_count": 23
    },
    {
      "verse_id": 3017,
      "surah_id": 26,
      "ayah_number": 85,
      "verse_key": "26-85",
      "page_number": 371,
      "text_raw": "وَاجْعَلْنِي مِنْ وَرَثَةِ جَنَّةِ النَّعِيمِ",
      "word_count": 5,
      "letter_count": 22
    },
    {
      "verse_id": 3018,
      "surah_id": 26,
      "ayah_number": 86,
      "verse_key": "26-86",
      "page_number": 371,
      "text_raw": "وَاغْفِرْ لِأَبِي إِنَّهُ كَانَ مِنْ الضَّالِّينَ",
      "word_count": 6,
      "letter_count": 24
    },
    {
      "verse_id": 3019,
      "surah_id": 26,
      "ayah_number": 87,
      "verse_key": "26-87",
      "page_number": 371,
      "text_raw": "وَلَا تُخْزِنِي يَوْمَ يُبْعَثُونَ",
      "word_count": 4,
      "letter_count": 17
    },
    {
      "verse_id": 3020,
      "surah_id": 26,
      "ayah_number": 88,
      "verse_key": "26-88",
      "page_number": 371,
      "text_raw": "يَوْمَ لَا يَنْفَعُ مَالٌ وَلَا بَنُونَ",
      "word_count": 6,
      "letter_count": 19
    },
    {
      "verse_id": 3021,
      "surah_id": 26,
      "ayah_number": 89,
      "verse_key": "26-89",
      "page_number": 371,
      "text_raw": "إِلَّا مَنْ أَتَى اللَّهَ بِقَلْبٍ سَلِيمٍ",
      "word_count": 6,
      "letter_count": 20
    },
    {
      "verse_id": 3022,
      "surah_id": 26,
      "ayah_number": 90,
      "verse_key": "26-90",
      "page_number": 371,
      "text_raw": "وَأُزْلِفَتِ الْجَنَّةُ لِلْمُتَّقِينَ",
      "word_count": 3,
      "letter_count": 18
    },
    {
      "verse_id": 3023,
      "surah_id": 26,
      "ayah_number": 91,
      "verse_key": "26-91",
      "page_number": 371,
      "text_raw": "وَبُرِّزَتِ الْجَحِيمُ لِلْغَاوِينَ",
      "word_count": 3,
      "letter_count": 18
    },
    {
      "verse_id": 3024,
      "surah_id": 26,
      "ayah_number": 92,
      "verse_key": "26-92",
      "page_number": 371,
      "text_raw": "وَقِيلَ لَهُمْ أَيْنَ مَا كُنْتُمْ تَعْبُدُونَ",
      "word_count": 6,
      "letter_count": 22
    },
    {
      "verse_id": 3025,
      "surah_id": 26,
      "ayah_number": 93,
      "verse_key": "26-93",
      "page_number": 371,
      "text_raw": "مِنْ دُونِ اللَّهِ هَلْ يَنْصُرُونَكُمْ أَوْ يَنْتَصِرُونَ",
      "word_count": 7,
      "letter_count": 28
    },
    {
      "verse_id": 3026,
      "surah_id": 26,
      "ayah_number": 94,
      "verse_key": "26-94",
      "page_number": 371,
      "text_raw": "فَكُبْكِبُوا فِيهَا هُمْ وَالْغَاوُونَ",
