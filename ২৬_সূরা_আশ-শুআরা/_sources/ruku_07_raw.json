      "letter_count": 21
    },
    {
      "verse_id": 3027,
      "surah_id": 26,
      "ayah_number": 95,
      "verse_key": "26-95",
      "page_number": 371,
      "text_raw": "وَجُنُودُ إِبْلِيسَ أَجْمَعُونَ",
      "word_count": 3,
      "letter_count": 16
    },
    {
      "verse_id": 3028,
      "surah_id": 26,
      "ayah_number": 96,
      "verse_key": "26-96",
      "page_number": 371,
      "text_raw": "قَالُوا وَهُمْ فِيهَا يَخْتَصِمُونَ",
      "word_count": 4,
      "letter_count": 19
    },
    {
      "verse_id": 3029,
      "surah_id": 26,
      "ayah_number": 97,
      "verse_key": "26-97",
      "page_number": 371,
      "text_raw": "تَاللَّهِ إِنْ كُنَّا لَفِي ضَلَالٍ مُبِينٍ",
      "word_count": 6,
      "letter_count": 21
    },
    {
      "verse_id": 3030,
      "surah_id": 26,
      "ayah_number": 98,
      "verse_key": "26-98",
      "page_number": 371,
      "text_raw": "إِذْ نُسَوِّيكُمْ بِرَبِّ الْعَالَمِينَ",
      "word_count": 4,
      "letter_count": 19
    },
    {
      "verse_id": 3031,
      "surah_id": 26,
      "ayah_number": 99,
      "verse_key": "26-99",
      "page_number": 371,
      "text_raw": "وَمَا أَضَلَّنَا إِلَّا الْمُجْرِمُونَ",
      "word_count": 4,
      "letter_count": 19
    },
    {
      "verse_id": 3032,
      "surah_id": 26,
      "ayah_number": 100,
      "verse_key": "26-100",
      "page_number": 371,
      "text_raw": "فَمَا لَنَا مِنْ شَافِعِينَ",
      "word_count": 4,
      "letter_count": 14
    },
    {
      "verse_id": 3033,
      "surah_id": 26,
      "ayah_number": 101,
      "verse_key": "26-101",
      "page_number": 371,
      "text_raw": "وَلَا صَدِيقٍ حَمِيمٍ",
      "word_count": 3,
      "letter_count": 11
    },
    {
      "verse_id": 3034,
      "surah_id": 26,
      "ayah_number": 102,
      "verse_key": "26-102",
      "page_number": 371,
      "text_raw": "فَلَوْ أَنَّ لَنَا كَرَّةً فَنَكُونَ مِنْ الْمُؤْمِنِينَ",
      "word_count": 7,
      "letter_count": 26
    },
    {
      "verse_id": 3035,
      "surah_id": 26,
      "ayah_number": 103,
      "verse_key": "26-103",
      "page_number": 371,
      "text_raw": "إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ",
      "word_count": 8,
      "letter_count": 29
    },
    {
      "verse_id": 3036,
      "surah_id": 26,
      "ayah_number": 104,
      "verse_key": "26-104",
      "page_number": 371,
      "text_raw": "وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ",
      "word_count": 5,
      "letter_count": 21
    }
